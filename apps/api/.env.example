# ── Server ─────────────────────────────────────────────
# Local dev values. On the server, deploy/setup-server.sh writes the production .env (port 4617).
NODE_ENV=development
PORT=4400
# Browser origins allowed to call the API (the Next.js app)
CORS_ORIGINS=http://localhost:3000
# Public URL of the web app (redirects after Google sign-in and card payments)
APP_URL=http://localhost:3000
# Public URL of the API as the internet sees it (Google + M-Pesa callbacks). Dev: through the Next proxy.
API_PUBLIC_URL=http://localhost:3000/api

# ── Database & cache ───────────────────────────────────
DATABASE_URL="postgresql://nubian_invoices_user:nubian_invoices%402026@127.0.0.1:5432/nubian_invoices?schema=public"
REDIS_URL=redis://127.0.0.1:6379
# Key prefix, so several apps can share one Redis
REDIS_PREFIX=tuli:

# ── Auth ───────────────────────────────────────────────
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
JWT_EXPIRES_IN=30d
# true in production (HTTPS)
COOKIE_SECURE=false
SIGNUP_ENABLED=true

# ── Google sign-in (console.cloud.google.com → APIs & Services → Credentials → OAuth client ID, type "Web application")
# Authorised redirect URI must match GOOGLE_REDIRECT_URI exactly.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback

# ── Sign in with Apple (developer.apple.com → Certificates, IDs & Profiles)
# 1. Identifiers → App ID with "Sign in with Apple" on. 2. Identifiers → Services ID (this is APPLE_SERVICES_ID),
#    enable Sign in with Apple, add your domain + Return URL = APPLE_REDIRECT_URI (must be https — Apple rejects localhost).
# 3. Keys → new key with Sign in with Apple → download AuthKey_XXXX.p8 (APPLE_KEY_ID = XXXX). Team ID is top-right.
# Paste the .p8 contents on one line with \n for line breaks.
APPLE_SERVICES_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
APPLE_REDIRECT_URI=https://your-domain.com/api/auth/apple/callback

# ── Rendering (headless Chrome via Puppeteer) ──────────
# Leave empty to use the Chrome that `npm install` downloads; or point at a system Chromium.
CHROME_PATH=
RENDER_CONCURRENCY=3

# ── M-Pesa ─────────────────────────────────────────────
# paystack (default) = M-Pesa runs in the same Paystack popup as cards (uses CARD_MODE + PAYSTACK_SECRET_KEY; the
#                      MPESA_* Daraja settings below are then ignored) · daraja = STK push direct from Safaricom
MPESA_GATEWAY=paystack

# ── M-Pesa Daraja (STK Push) — only used when MPESA_GATEWAY=daraja ─
# mock = no network, payments succeed after ~5s (numbers ending in 000 fail) · sandbox · live
MPESA_MODE=mock
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
# Sandbox test shortcode/passkey are on developer.safaricom.co.ke
MPESA_SHORTCODE=174379
MPESA_PASSKEY=
# CustomerPayBillOnline (Paybill) or CustomerBuyGoodsOnline (Till; set MPESA_PARTY_B to the till number)
MPESA_TRANSACTION_TYPE=CustomerPayBillOnline
MPESA_PARTY_B=
# Random string — part of the callback URL so nobody else can post results
MPESA_CALLBACK_SECRET=dev

# ── Paystack (cards, and M-Pesa when MPESA_GATEWAY=paystack) ─
# mock = no network, a local page stands in for the card form · live = use PAYSTACK_SECRET_KEY (sk_test_… or sk_live_…)
CARD_MODE=mock
PAYSTACK_SECRET_KEY=
# Webhook URL to set in Paystack → Settings → API Keys & Webhooks:  {API_PUBLIC_URL}/payments/paystack/webhook

# ── KRA eTIMS (OSCU) — placeholder until certified ─────
ETIMS_ENABLED=false
